# Copy to `.env` at the repo root. Never commit `.env`.
#
# FastAPI reads only the keys below (plus OPENAI_API_KEY as a fallback for the
# secret). Chat/embedding hosts and model slugs stay in config/model_config.yaml.

# Required. Same key FastAPI uses for embeddings.
LLM_API_KEY=

# Optional local defaults — keep these unless you know you need other paths.
FRONTEND_ORIGIN=http://localhost:3000
VECTOR_DB_URI=data/vectordb
MEMORY_DB_PATH=data/cache/memory.sqlite

# Docker Compose `web` only (interpolated into the Next.js container).
# Local `pnpm dev` ignores this file; copy web/.env.example → web/.env.local instead.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=gpt-4o-mini
